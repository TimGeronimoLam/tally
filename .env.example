# Copy to .env.local (git-ignored) and fill in from
# Supabase dashboard → Project Settings → API.
# Both values are safe to ship to the browser; RLS protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Daily push reminder: the public half of `node scripts/gen-vapid.mjs`.
# Also safe for the browser. Leave empty and the reminder row says
# "Not supported here".
VITE_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile site key (public), see README "Captcha". Required once
# the captcha is turned on in Supabase; leave empty while it is off. For
# local development use Cloudflare's always-passing test key
# 1x00000000000000000000AA with the matching test secret in Supabase.
VITE_TURNSTILE_SITE_KEY=
