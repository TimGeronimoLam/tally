// Cloudflare Workers: serve the Vite build as static assets, and send the
// daily push reminders from a cron trigger (worker/index.ts).
// Deployed by `npx wrangler deploy` after `npm run build`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tally",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths (/stats, /join/CODE) serve index.html so the router handles them.
    "not_found_handling": "single-page-application",
  },
  // Every 15 minutes: reminders go out within 15 minutes of the chosen time.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  // The reminder settings live in the dashboard (Variables and Secrets);
  // without this, each deploy would delete the plain-text ones.
  "keep_vars": true,
}
